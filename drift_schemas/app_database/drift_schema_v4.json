    },
    {
      "name": "members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"members\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"photo_url\" TEXT NULL, \"tier\" TEXT NOT NULL, \"points\" INTEGER NOT NULL, \"next_tier\" TEXT NULL, \"points_to_next_tier\" INTEGER NULL, \"notification_count\" INTEGER NOT NULL, \"available_rewards\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
