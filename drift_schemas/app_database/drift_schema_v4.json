    {
      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"phone\" TEXT NOT NULL UNIQUE, \"first_name\" TEXT NOT NULL, \"last_name\" TEXT NULL, \"date_of_birth\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP));"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" TEXT NOT NULL, \"code\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"price_mmk\" INTEGER NOT NULL, \"is_new\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_new\" IN (0, 1)), \"discount_percent\" INTEGER NULL, \"image_url\" TEXT NOT NULL, \"description\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "banners",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"banners\" (\"id\" TEXT NOT NULL, \"tag\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"image_url\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sections\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "section_products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"section_products\" (\"section_id\" TEXT NOT NULL REFERENCES sections (id) ON DELETE CASCADE, \"product_id\" TEXT NOT NULL REFERENCES products (id) ON DELETE CASCADE, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"section_id\", \"product_id\"));"
        }
      ]
    },
    {
      "name": "shops",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shops\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"address\" TEXT NOT NULL, \"image_url\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
